{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitPersona",
  "version": "0.5.0",
  "identifier": "dev.gitpersona.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self'; font-src 'self' data:; script-src 'self'"
    },
    "windows": [{
      "title": "GitPersona",
      "width": 1180,
      "height": 760,
      "minWidth": 720,
      "minHeight": 560,
      "resizable": true
    }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Safety-first local GitHub identity manager"
  }
}
